      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/customer/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Bob Customer\",\n  \"email\": \"bob_cust_test@example.com\",\n  \"password\": \"TestPass123!\",\n  \"phone\": \"9822222230\"\n}"
            }
          }
        },
        {
          "name": "Verify Email (POST)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/customer/verify-email",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"<verification_token>\"\n}" }
          }
        },
        {
          "name": "Login Customer",
          "request": {
            "method": "POST",
